# OpsPilot application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# Anthropic or an Anthropic-compatible provider
ANTHROPIC_API_KEY=replace-with-your-api-key
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-flash

# DeepSeek Anthropic-compatible API only: ensure short JSON tasks return final text.
DEEPSEEK_THINKING_MODE=disabled
DEEPSEEK_REASONING_EFFORT=low

# Intent routing
INTENT_CONFIDENCE_THRESHOLD=0.55

# ChromaDB
CHROMA_MODE=local
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Dynamic diagnosis SOPs
OPSPILOT_SKILLS_DIR=./skills
OPSPILOT_SKILLS_MAX_PROMPT_CHARS=5000

# Evaluation baseline
EVAL_BASELINE_PATH=./data/eval/opspilot_baseline.json
EVAL_DATASET_PATH=./evaluation/datasets/opspilot_eval_200.json
EVAL_CONCURRENCY=4
